{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concurso-hub-api-local",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "vars": {
    "QUESTIONS_TERMS_ACCEPTED": "false",
    "GEMINI_EDITAL_MODEL": "gemini-3.6-flash",
    "GROQ_EDITAL_MODEL": "llama-3.3-70b-versatile",
    "GROQ_EXPLANATION_MODEL": "llama-3.3-70b-versatile",
    "GROQ_WHISPER_MODEL": "whisper-large-v3-turbo",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
